{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One write request through the SlimBus pipeline, auto-save and event publishing",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      696
    ],
    "legend": {
      "entries": {
        "default": {
          "label": "Plain in-process call"
        },
        "emphasis": {
          "label": "Write path"
        },
        "dashed": {
          "label": "Conditional step"
        },
        "return": {
          "label": "Result back to caller"
        }
      }
    }
  },
  "participants": [
    {
      "id": "caller",
      "type": "external",
      "label": "Caller",
      "sublabel": "endpoint or job"
    },
    {
      "id": "bus",
      "type": "messagebus",
      "label": "IMessageBus",
      "sublabel": "SlimMessageBus"
    },
    {
      "id": "custom",
      "type": "backend",
      "label": "Your interceptors"
    },
    {
      "id": "autosave",
      "type": "backend",
      "label": "Auto-save",
      "sublabel": "Order = int.MaxValue"
    },
    {
      "id": "handler",
      "type": "backend",
      "label": "Request handler",
      "sublabel": "Fluents.Requests.IHandler"
    },
    {
      "id": "db",
      "type": "database",
      "label": "DbContext",
      "sublabel": "registered for auto-save"
    },
    {
      "id": "publisher",
      "type": "cloud",
      "label": "Event publisher",
      "sublabel": "SlimBusEventPublisher"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 287,
      "label": "Request in"
    },
    {
      "from": 295,
      "to": 370,
      "label": "Handler runs"
    },
    {
      "from": 378,
      "to": 606,
      "label": "Auto-save, then publish"
    }
  ],
  "messages": [
    {
      "id": "send",
      "from": "caller",
      "to": "bus",
      "y": 170,
      "label": "Send(request)",
      "variant": "emphasis"
    },
    {
      "id": "interceptor-chain",
      "from": "bus",
      "to": "custom",
      "y": 204,
      "label": "OnHandle(request, next)",
      "note": "Every IRequestHandlerInterceptor<TRequest, TResponse> you register runs here, in Order sequence."
    },
    {
      "id": "next-custom",
      "from": "custom",
      "to": "autosave",
      "y": 236,
      "label": "next()",
      "note": "Order = int.MaxValue puts auto-save last in the chain, so it wraps the handler and runs after your own interceptors."
    },
    {
      "id": "next-handler",
      "from": "autosave",
      "to": "handler",
      "y": 279,
      "label": "next()",
      "variant": "emphasis"
    },
    {
      "id": "mutate",
      "from": "handler",
      "to": "db",
      "y": 311,
      "label": "load and change entities",
      "note": "The handler never calls SaveChangesAsync itself."
    },
    {
      "id": "result",
      "from": "handler",
      "to": "autosave",
      "y": 354,
      "label": "IResultBase",
      "variant": "return"
    },
    {
      "id": "has-changes",
      "from": "autosave",
      "to": "db",
      "y": 389,
      "label": "ChangeTracker.HasChanges()?",
      "variant": "dashed",
      "note": "Skipped entirely when the response is null, is a failed IResultBase, or the request is not a Fluents.Requests write."
    },
    {
      "id": "save",
      "from": "autosave",
      "to": "db",
      "y": 440,
      "label": "SaveChangesWithConcurrencyHandlingAsync",
      "variant": "emphasis"
    },
    {
      "id": "hook-publish",
      "from": "db",
      "to": "publisher",
      "y": 475,
      "label": "after-save hook hands over the raised events"
    },
    {
      "id": "bus-publish",
      "from": "publisher",
      "to": "bus",
      "y": 507,
      "label": "Publish(event), one at a time in order",
      "note": "For an IEventItem, AdditionalData is copied onto the message as case-insensitive headers."
    },
    {
      "id": "respond",
      "from": "autosave",
      "to": "bus",
      "y": 553,
      "label": "response",
      "variant": "return"
    },
    {
      "id": "to-caller",
      "from": "bus",
      "to": "caller",
      "y": 585,
      "label": "response",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "bus",
      "from": 166,
      "to": 606,
      "type": "messagebus"
    },
    {
      "participant": "custom",
      "from": 200,
      "to": 558,
      "type": "backend"
    },
    {
      "participant": "autosave",
      "from": 232,
      "to": 556,
      "type": "backend"
    },
    {
      "participant": "handler",
      "from": 275,
      "to": 359,
      "type": "backend"
    },
    {
      "participant": "db",
      "from": 307,
      "to": 512,
      "type": "database"
    },
    {
      "participant": "publisher",
      "from": 471,
      "to": 512,
      "type": "cloud"
    }
  ]
}
