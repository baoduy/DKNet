  "nodes": [
    {
      "id": "typeform",
      "type": "external",
      "label": "Type-naming form",
      "sublabel": "[RaisesEvent(typeof(X), ops)]",
      "stage": 0,
      "row": 0,
      "width": 150,
      "tag": "you own the record"
    },
    {
      "id": "labelform",
      "type": "external",
      "label": "Label form",
      "sublabel": "[RaisesEvent(\"Touched\", ops)]",
