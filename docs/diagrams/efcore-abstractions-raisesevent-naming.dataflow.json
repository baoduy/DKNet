      "stage": 0,
      "row": 3,
      "width": 150
    },
    {
      "id": "composer",
      "type": "backend",
      "label": "EventNameComposer",
      "sublabel": "Compose(entity, label, props, ops)",
      "stage": 1,
      "row": 2,
      "width": 150,
      "tag": "one file, build and runtime"
    },
    {
      "id": "dto",
      "type": "backend",
      "label": "Your [GenerateDto] record",
      "sublabel": "you declare it, generator fills it",
      "stage": 2,
      "row": 0,
      "width": 150
    },
    {
      "id": "composed",
      "type": "backend",
      "label": "Generated record",
      "sublabel": "public partial record ...Event",
      "stage": 2,
      "row": 2,
      "width": 150,
      "tag": "entity's own namespace"
    },
    {
      "id": "hook",
      "type": "messagebus",
      "label": "EventHook",
