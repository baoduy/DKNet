  "flows": [
    {
      "from": "typeform",
      "to": "dto",
      "label": "EventType names it",
      "classification": "same entity, build-checked",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "labelform",
      "to": "composer",
      "label": "label + props + ops",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": -38
    },
    {
      "from": "plainform",
      "to": "composer",
      "label": "props + ops",
      "variant": "default"
    },
    {
      "from": "composer",
      "to": "composed",
      "label": "composed name",
      "classification": "DtoGenerator emits it",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": -38
    },
    {
      "from": "dto",
      "to": "hook",
      "label": "raised as declared",
      "variant": "emphasis"
    },
    {
      "from": "composed",
      "to": "hook",
      "label": "re-composed at save",
      "classification": "same source, cannot drift",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Composition order is fixed",
      "items": [
        "Entity name, then the label when one is given",
        "Then narrowing properties, de-duplicated and ordinal-sorted",
        "Then operations in the order Created, Updated, Deleted",
        "Then the literal suffix Event"
      ]
    },
    {
      "dot": "rose",
      "title": "What the build rejects",
      "items": [
        "A composed name that is not a valid C# identifier (DKRAISEVT005)",
        "Two declarations composing to the same name (DKRAISEVT006 / DKRAISEVT008)",
        "Exclude or Include on the type-naming form (DKRAISEVT011)"
      ]
    }
  ]
}
