  "cards": [
    {
      "dot": "cyan",
      "title": "Why it is lazy",
      "items": [
        "Every filter call returns another ITypeExtractor, additive with the ones before it",
        "Reflection only runs when you enumerate, so an unused chain costs nothing",
        "ITypeExtractor is IEnumerable<Type>, so LINQ composes on top of it"
      ]
    },
    {
      "dot": "emerald",
      "title": "The rest of the package",
      "items": [
        "Primitives: string, DateTime and enum helpers with Display metadata",
        "Reflection: property get/set by name, attribute lookups, type tests",
        "Registration guards: IsRegistered and IsRegisteredWithImplementation"
      ]
    }
  ]
