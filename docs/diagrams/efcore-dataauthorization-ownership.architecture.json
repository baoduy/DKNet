  "cards": [
    {
      "dot": "cyan",
      "title": "Read path",
      "items": [
        "An empty AccessibleKeys collection denies every owned row",
        "Only IsUnrestrictedAccess bypasses the filter, and it is opt-in",
        "A DbContext that is not IDataOwnerDbContext throws instead of showing everything"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write path",
      "items": [
        "OwnedBy comes from the ownership key, and only DataOwnerHook ever stamps it",
        "A non-empty GetCurrentUser() moves CreatedBy and UpdatedBy to EfCoreAuditHook",
        "No provider, or no user for that save, leaves the ownership key filling them as before",
        "Both hooks keep an explicit SetCreatedBy or SetUpdatedBy already recorded",
        "Reassigning OwnedBy outside the accessible keys reverts to the original owner"
      ]
    }
  ]
