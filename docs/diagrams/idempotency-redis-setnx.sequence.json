{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One protected request against the Redis store: SET NX reservation, then replay cache",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1085,
      655
    ],
    "legend": {
      "entries": {
        "default": {
          "label": "Non-atomic Redis call"
        },
        "emphasis": {
          "label": "Atomic step"
        },
        "return": {
          "label": "Reply to the caller"
        }
      }
    }
  },
  "participants": [
    {
      "id": "filter",
      "type": "external",
      "label": "Endpoint filter",
      "sublabel": "RequiredIdempotentKey()"
    },
    {
      "id": "store",
      "type": "backend",
      "label": "IdempotencyRedisStore",
      "sublabel": "internal IIdempotencyKeyStore"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "StackExchange.Redis IDatabase"
    },
    {
      "id": "handler",
      "type": "backend",
      "label": "Endpoint handler",
      "sublabel": "runs at most once per key"
    }
  ],
  "segments": [
    {
      "from": 154,
      "to": 363,
      "label": "Check and reserve"
    },
    {
      "from": 378,
      "to": 447,
      "label": "Run once"
    },
    {
      "from": 463,
      "to": 565,
      "label": "Cache the response"
    }
  ],
  "messages": [
    {
      "id": "check",
      "from": "filter",
      "to": "store",
      "y": 170,
      "label": "IsKeyProcessedAsync(keyInfo)",
      "variant": "emphasis"
    },
    {
      "id": "get",
      "from": "store",
      "to": "redis",
      "y": 205,
      "label": "GET prefix + sha256(compositeKey)",
      "note": "Only the lowercase hex SHA-256 digest of Scope:Method:Endpoint:Key reaches Redis, behind CachePrefix."
    },
    {
      "id": "miss",
      "from": "redis",
      "to": "store",
      "y": 240,
      "label": "nil",
      "variant": "return"
    },
    {
      "id": "setnx",
      "from": "store",
      "to": "redis",
      "y": 275,
      "label": "SET key <102 reservation> NX, TTL InFlightReservationTimeout",
      "variant": "emphasis",
      "note": "Atomicity primitive. A losing caller re-reads the key: (true, null) while the 102 sentinel holds, (true, response) once the winner completed."
    },
    {
      "id": "reserved",
      "from": "redis",
      "to": "store",
      "y": 310,
      "label": "OK, reservation held",
      "variant": "return"
    },
    {
      "id": "proceed",
      "from": "store",
      "to": "filter",
      "y": 345,
      "label": "(false, null)",
      "variant": "return"
    },
    {
      "id": "invoke",
      "from": "filter",
      "to": "handler",
      "y": 396,
      "label": "next(context)",
      "variant": "emphasis"
    },
    {
      "id": "result",
      "from": "handler",
      "to": "filter",
      "y": 431,
      "label": "result",
      "variant": "return"
    },
    {
      "id": "mark",
      "from": "filter",
      "to": "store",
      "y": 481,
      "label": "MarkKeyAsProcessedAsync(keyInfo, response)",
      "note": "Only reached when the status code is cacheable; otherwise the reservation is left to expire on its own."
    },
    {
      "id": "set",
      "from": "store",
      "to": "redis",
      "y": 516,
      "label": "SET key <response>, TTL Expiration",
      "variant": "emphasis",
      "note": "Unconditional SET: the reservation is overwritten and the TTL becomes Expiration, four hours by default."
    },
    {
      "id": "done",
      "from": "store",
      "to": "filter",
      "y": 551,
      "label": "cached",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "store",
      "from": 166,
      "to": 556,
      "type": "backend"
    },
    {
      "participant": "redis",
      "from": 201,
      "to": 521,
      "type": "database"
    },
    {
      "participant": "handler",
      "from": 392,
      "to": 436,
      "type": "backend"
    }
  ]
}
