  "cards": [
    {
      "dot": "cyan",
      "title": "Two ways in",
      "items": [
        "AddEvent(instance) queues a pre-built event; AddEvent<TEvent>() and [RaisesEvent] map the entity onto the event type, so both need an IMapper.",
        "Two [RaisesEvent] rules naming the same payload for the same operation raise it once."
      ]
    },
    {
      "dot": "rose",
      "title": "Guarantees and gaps",
      "items": [
        "Nothing is published until the write succeeds, and each IEventItem carries a sourceType header.",
        "Publisher failures are logged and swallowed — the save still succeeds and the event is lost."
      ]
    }
  ]
