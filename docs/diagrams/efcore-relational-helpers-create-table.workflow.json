  "cards": [
    {
      "dot": "amber",
      "title": "Read this before calling it",
      "items": [
        "CreateTablesAsync creates every table missing from the model, not only TEntity",
        "TableExistsAsync swallows any DbException, so a permission error reads as absent",
        "Nothing here records a migration, so mixing it with migrations diverges the schema"
      ]
    },
    {
      "dot": "cyan",
      "title": "The rest of the surface",
      "items": [
        "GetDbConnection opens the connection when it is closed, and leaves it open",
        "GetTableName returns (null, null) for a type that is not in the model",
        "GetTableName defaults the schema to dbo only on SQL Server"
      ]
    }
  ]
