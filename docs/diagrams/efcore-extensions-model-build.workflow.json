  "cards": [
    {
      "dot": "cyan",
      "title": "What each configuration gets for free",
      "items": [
        "Id becomes the key; Guid keys get the GUID v7 generator",
        "IAuditedProperties columns are sized and made insert-only",
        "IConcurrencyEntity RowVersion becomes a row-version token"
      ]
    },
    {
      "dot": "amber",
      "title": "Registered separately",
      "items": [
        "UseAutoDataSeeding attaches EF Core's UseSeeding / UseAsyncSeeding",
        "AddEfCoreExceptionHandler registers a keyed concurrency handler"
      ]
    }
  ]
