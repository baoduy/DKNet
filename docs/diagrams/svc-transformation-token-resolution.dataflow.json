  "cards": [
    {
      "dot": "cyan",
      "title": "What you can replace",
      "items": [
        "DefaultDefinitions: add a bracket pair, square brackets stay",
        "Formatter: subclass ValueFormatter or implement IValueFormatter",
        "GlobalParameters: sources tried after the call's own arguments"
      ]
    },
    {
      "dot": "rose",
      "title": "The resolved-value cache",
      "items": [
        "Every resolved value is cached on the service instance",
        "The key is the token text, not the data you passed",
        "Reusing one instance for a second record replays the first value"
      ]
    }
  ]
