  "cards": [
    {
      "dot": "cyan",
      "title": "What the converter changes",
      "items": [
        "Null and empty values pass through untouched, never encrypted",
        "Each write draws a fresh random IV, so the same plaintext stores differently",
        "Ciphertext is Base64, so plan the column length for the expansion"
      ]
    },
    {
      "dot": "rose",
      "title": "What it cannot do",
      "items": [
        "No server-side equality, LIKE, sorting or indexing on an encrypted column",
        "Keys are resolved once per model, so rotation needs a rebuild and a data migration",
        "A wrong key surfaces as InvalidOperationException on read, not a silent miss"
      ]
    }
  ]
}
