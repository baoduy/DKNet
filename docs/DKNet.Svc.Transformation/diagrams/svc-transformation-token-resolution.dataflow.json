  "cards": [
    {
      "dot": "cyan",
      "title": "What you can replace",
      "items": [
        "DefaultDefinitions: add a bracket pair, square brackets stay",
        "Formatter: subclass ValueFormatter or implement IValueFormatter",
        "GlobalParameters: sources tried after the call's own arguments"
      ]
    },
    {
      "dot": "rose",
      "title": "The resolved-value cache",
      "items": [
        "Scoped to one Transform/TransformAsync call, not the service instance",
        "The key is the token text, so a token repeated in one template resolves once",
        "A fresh cache is created per call, so a second call never sees the first call's values"
      ]
    }
