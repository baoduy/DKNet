  "cards": [
    {
      "dot": "cyan",
      "title": "Composition order is fixed",
      "items": [
        "Entity name, then the label when one is given",
        "Then narrowing properties, de-duplicated and ordinal-sorted",
        "Then operations in the order Created, Updated, Deleted",
        "Then the literal suffix Event"
      ]
    },
    {
      "dot": "rose",
      "title": "What the build rejects",
      "items": [
        "A composed name that is not a valid C# identifier (DKRAISEVT005)",
        "Two declarations composing to the same name (DKRAISEVT006 / DKRAISEVT008)",
        "Exclude or Include on the type-naming form (DKRAISEVT011)"
      ]
    }
