  "cards": [
    {
      "dot": "cyan",
      "title": "Two alphabets, one helper set",
      "items": [
        "ToBase64String/FromBase64String use the standard '+','/','=' alphabet",
        "ToBase64UrlString/FromBase64UrlString swap in '-','_' and drop padding",
        "Both decode helpers return string.Empty for null, empty, or whitespace input"
      ]
    },
    {
      "dot": "rose",
      "title": "IsBase64String checks one alphabet only",
      "items": [
        "It validates the standard Base64 alphabet, not Base64URL",
        "A token produced by ToBase64UrlString can return false here even though FromBase64UrlString decodes it fine",
        "There is no IsBase64UrlString helper to check the URL-safe form directly"
      ]
    }
  ]
