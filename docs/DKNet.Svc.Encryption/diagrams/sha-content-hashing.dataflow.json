  "cards": [
    {
      "dot": "cyan",
      "title": "Verification is hex-only and constant-time",
      "items": [
        "expectedHex must be hexadecimal; FixedTimeEquals runs on the decoded bytes",
        "Invalid hex returns false instead of throwing a FormatException",
        "Empty string input is allowed; null throws ArgumentNullException"
      ]
    },
    {
      "dot": "rose",
      "title": "ignoreCase does nothing",
      "items": [
        "Comparison runs on decoded bytes, so case never changes the result",
        "upperCase only changes ComputeSha256/512's own hex casing",
        "IHmacHashing's Verify* overloads do not even expose the parameter"
      ]
    }
