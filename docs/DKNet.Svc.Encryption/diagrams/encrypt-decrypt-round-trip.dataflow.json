  "cards": [
    {
      "dot": "cyan",
      "title": "AddEncryptionServices registers no cipher",
      "items": [
        "Only IShaHashing and IHmacHashing come from AddEncryptionServices",
        "Each cipher needs its own registration call with an explicit key",
        "All registration methods are idempotent: a second call changes nothing"
      ]
    },
    {
      "dot": "rose",
      "title": "Ciphertext is never deterministic",
      "items": [
        "A fresh random 12-byte nonce and 16-byte tag are generated per call",
        "The package layout is base64(nonce):base64(tag):base64(cipher), base64-wrapped",
        "associatedData is optional; a mismatch on decrypt throws, it is never silently ignored"
      ]
    }
  ]
