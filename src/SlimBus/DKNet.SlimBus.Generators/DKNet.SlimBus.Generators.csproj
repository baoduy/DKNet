<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Source generators must target netstandard2.0 -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <RoslynComponentsPackage>true</RoslynComponentsPackage>
        <!-- Don't include the generator DLL in the lib folder -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- This is a development dependency -->
        <DevelopmentDependency>true</DevelopmentDependency>
        <!-- Disable symbols package for source generators -->
        <IncludeSymbols>false</IncludeSymbols>
        <!-- Suppress warnings about netstandard2.0 -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SlimBus.Generators.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Analyzers/generators must reference the LOWEST Roslyn they need to run under, not the
             newest: the running compiler must be >= the referenced version (CS9057). The IDE's csc
             (5.6) is older than the CLI SDK's, so pin down here rather than using the 5.9.0 CPM
             version, keeping the generator loadable in both. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.11.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Pack the generator DLL as an analyzer -->
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>

        <!-- Standard package files -->
        <None Include="..\..\NugetLogo.png" Pack="true" PackagePath="\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
