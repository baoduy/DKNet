<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Source generators must target netstandard2.0 -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <RoslynComponentsPackage>true</RoslynComponentsPackage>
        <!-- Don't include the generator DLL in the lib folder -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- This is a development dependency -->
        <DevelopmentDependency>true</DevelopmentDependency>
        <!-- Disable symbols package for source generators -->
        <IncludeSymbols>false</IncludeSymbols>
        <!-- Suppress warnings about netstandard2.0 -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="EfCore.DtoGenerator.Tests"/>
        <InternalsVisibleTo Include="EfCore.DtoGenerator.Tests.ProjectWide"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Pack the generator DLL as an analyzer -->
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>

        <!-- Include the attribute file in consuming projects -->
        <None Include="GenerateDtoAttribute.cs" Pack="true" PackagePath="contentFiles/cs/any;content" BuildAction="Compile"/>

        <!-- Pack the MSBuild props so CompilerVisibleProperty declarations reach consuming projects -->
        <None Include="DKNet.EfCore.DtoGenerator.props" Pack="true" PackagePath="buildTransitive/"/>

        <!-- Standard package files -->
        <None Include="..\..\NugetLogo.png" Pack="true" PackagePath="\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
