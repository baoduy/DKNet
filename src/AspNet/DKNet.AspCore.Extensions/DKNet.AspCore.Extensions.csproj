<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsAspNetCoreApp>true</IsAspNetCoreApp>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\NugetLogo.png" Pack="true" PackagePath="\"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentResults"/>
        <PackageReference Include="Asp.Versioning.Http"/>
        <!-- Kept so the README's AddFluentValidationAutoValidation() migration example compiles in a host;
             do not prune in a dependency sweep. -->
        <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Endpoints"/>
        <!-- IOpenApiSchemaTransformer/IOpenApiOperationTransformer for excluding IContextualSource-declared
             members from the published OpenAPI description (DRK-565). Version pinned centrally. -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\SlimBus\DKNet.SlimBus.Extensions\DKNet.SlimBus.Extensions.csproj"/>
        <ProjectReference Include="..\..\EfCore\DKNet.EfCore.Specifications\DKNet.EfCore.Specifications.csproj"/>
    </ItemGroup>
</Project>
